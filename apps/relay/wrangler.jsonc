{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "grokeven",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grokeven",
      // Replace with the real database_id after `wrangler d1 create grokeven`.
      "database_id": "2f82aa5d-64f5-4700-824d-d7ec0e7c34e4",
      "migrations_dir": "migrations"
    }
  ],
  // Local / verification defaults. "manual" returns the per-request result token to the caller so the
  // operator can hand it to the Bot. It must never be used on a deployed Worker.
  "vars": {
    "BOT_ADAPTER": "manual",
    "OWNER_ID": "owner-1",
    "RESULT_TOKEN_TTL_SECONDS": "1800",
    "ALLOWED_ORIGINS": ""
  },
  "env": {
    "production": {
      "d1_databases": [
        { "binding": "DB", "database_name": "grokeven", "database_id": "2f82aa5d-64f5-4700-824d-d7ec0e7c34e4", "migrations_dir": "migrations" }
      ],
      "vars": {
        "BOT_ADAPTER": "routine-webhook",
        "OWNER_ID": "owner-1",
        "RESULT_TOKEN_TTL_SECONDS": "1800",
        // The Even Hub WebView origin is undocumented (docs/phase0-research.md); "*" is safe because auth is a
        // bearer token (no cookies). Narrow to the real origin once GET /v1/whoami reports it from the device.
        "ALLOWED_ORIGINS": "*"
      }
    }
  }
  // Secrets (set with `wrangler secret put --env production` or in .dev.vars):
  //   DEVICE_TOKEN                 client auth for /v1/requests endpoints
  //   RESULT_URL                   public URL the Bot posts results to, e.g. https://grokeven.<acct>.workers.dev/v1/bot-results
  //   ROUTINE_WEBHOOK_URL          Grok Bot routine webhook endpoint (BOT_ADAPTER=routine-webhook)
  //   ROUTINE_WEBHOOK_SECRET       key issued with the routine webhook
  //   ROUTINE_WEBHOOK_AUTH_HEADER  header carrying the key ("Authorization" => Bearer). Default: Authorization
}
