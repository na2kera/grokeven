{
  "name": "grokeven-glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack \"$PWD/app.json\" \"$PWD/dist\" -o grokeven.ehpk --sdk-ver 0.0.16",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.1.14",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
